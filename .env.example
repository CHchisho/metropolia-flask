# Copy to .env and adjust. 

# --- Storage ---
DATABASE_PATH=data/app.db
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=10
SEED_SAMPLE_DOCS=true

# --- RAG ---
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=4
# Minimum cosine similarity for a chunk to count as relevant
MIN_SCORE=0.10
HISTORY_TURNS=4

# --- LLM: "demo" (offline, extractive) or "openai" (any OpenAI-compatible API) ---
LLM_PROVIDER=demo
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
# Ollama example: LLM_PROVIDER=openai, LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=llama3.1

# --- Embeddings: "local" (offline hashing embedder) or "openai" ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
# Optional; default to the LLM_* values
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
